# ---------------------------------------------------------------- runtime / test artifacts
# Test , bench and chaos scripts write all their evidence here (models, read.json, screenshots,
# bench output). Regenerated on demand -- never commit it.
/tmp/

# ---------------------------------------------------------------- compiled binaries
# bin\cache\<sha12>\CadHelper.exe : helper compiled from scripts\helper\*.cs, keyed by source
# hash. bin\CadClient.exe + .sha are built by `scripts\cad.cmd` on first use (csc, 1-2 s).
# A fresh clone bootstraps all of them, so the binaries stay out of the repo: a committed exe
# would go stale against the .cs sources it was built from.
/bin/cache/
/bin/CadClient.exe
/bin/CadClient.sha
/bin/CadClient.exe.build-*.exe
/bin/tray/CadTray.exe

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]

# Offline fallback wheels for the data side (numpy / openpyxl / xlrd / ezdxf ...). Large and
# machine specific; install with pip instead (see README "数据侧").
/tools/py-libs/

# ---------------------------------------------------------------- task outputs
# /output/ holds the deliverables of a real section job (xlsx / csv / preview png of the user's
# drawings, 1.1 MB regenerable from the source drawings). Engineering data must not enter the
# repo, and every file in it can be rebuilt by re-running prepare.py / section.
/output/

# CAD lock files. Every other CAD tool that opens a drawing next to this one creates <name>.dwl
# and .dwl2 carrying the CURRENT USER NAME and MACHINE NAME (verified: "Administrator /
# WIN-4KRLTLRR4L5 / 2026-11-04"), i.e. transient machine information, never content.
*.dwl
*.dwl2

# ---------------------------------------------------------------- agent harness scratch
# `.dsh/` is created by the DeepSeek Harness inside the workspace (pasted screenshots and
# attachments, session scratch). Machine/session specific, never source: keep it out of the repo.
/.dsh/

# ---------------------------------------------------------------- editor / OS noise
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
