        {
          "name": "query1",
          "kind": "cad",
          "cmd": "query",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Type",
            "line",
            "-Mode",
            "summary"
          ]
        },
        {
          "name": "gen1",
          "kind": "py",
          "script": "tests/bench/checkers/gen_entity_request.py",
          "args": [
            "--mode",
            "delete-zero-length",
            "--query",
            "{stepfile:query1}",
            "--out",
            "{rundir}/w5-entity.json"
          ]
        },
        {
          "name": "entity1",
          "kind": "cad",
          "cmd": "entity",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Items",
            "{rundir}/w5-entity.json"
          ],
          "timeoutSec": 180
        },
        {
          "name": "read1",
          "kind": "cad",
          "cmd": "read",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Mode",
            "geom",
            "-Max",
            "20000"
          ]
        }
      ],
      "maxCommands": 5,
      "undoCheck": true,
      "setup": {
        "copyFixture": "design-water.dxf"
      }
    },
    {
      "id": "W6-xdata-mark",
      "category": "edit",
      "goal": "给 2 个文字实体打上自定义标记 ZWC=BENCH，按标记把它们筛出来确认，然后按标记删掉。",
      "why": "打标（entity update xdata）→ query -XData 筛出 → entity delete 的完整闭环；handle 稳定，所以一条本地 gen 步骤就能同时生成打标和删除两份请求",
      "steps": [
        {
          "name": "open1",
          "kind": "cad",
          "cmd": "open",
          "args": [
            "-Doc",
            "{workdoc}"
          ]
        },
        {
          "name": "query1",
          "kind": "cad",
          "cmd": "query",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Layer",
            "ANNO",
            "-Type",
            "text",
            "-Limit",
            "2",
            "-Mode",
            "summary"
          ]
        },
        {
          "name": "gen1",
          "kind": "py",
          "script": "tests/bench/checkers/gen_entity_request.py",
          "args": [
            "--mode",
            "mark-xdata",
            "--query",
            "{stepfile:query1}",
            "--app",
            "AI_MARK",
            "--value",
            "bench",
            "--out",
            "{rundir}/w6-mark.json",
            "--also-out",
            "{rundir}/w6-delete.json"
          ]
        },
        {
          "name": "entity1",
          "kind": "cad",
          "cmd": "entity",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Items",
            "{rundir}/w6-mark.json"
          ],
          "timeoutSec": 180
        },
        {
          "name": "query2",
          "kind": "cad",
          "cmd": "query",
          "args": [
            "-Doc",
            "{workdoc}",
            "-XData",
            "AI_MARK:bench",
            "-Mode",
            "summary"
          ]
        },
        {
          "name": "entity2",
          "kind": "cad",
          "cmd": "entity",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Items",
            "{rundir}/w6-delete.json"
          ],
          "timeoutSec": 180
        },
        {
          "name": "query3",
          "kind": "cad",
          "cmd": "query",
          "args": [
            "-Doc",
            "{workdoc}",
            "-XData",
            "AI_MARK:bench",
            "-Mode",
            "summary"
          ]
        },
        {
          "name": "read1",
          "kind": "cad",
          "cmd": "read",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Mode",
            "geom",
            "-Max",
            "20000"
          ]
        }
      ],
      "maxCommands": 8,
      "undoCheck": true,
      "setup": {
        "copyFixture": "design-water.dxf"
      }
    },
