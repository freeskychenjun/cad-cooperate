{
  "schema": "zwcad-bench-tasks/1",
  "name": "M3-E4 CAD task benchmark",
  "note": "任务级基准（不是命令级）：每条 = 一句用户会说的话 + agent 的执行序列 + 判定口径。runner 见 scripts/bench/run_bench.ps1，判定见 tests/bench/checkers/check.py。",
  "defaults": {
    "repeat": 3,
    "timeoutSec": 300,
    "maxCommands": 6
  },
  "assets": {
    "bigMap": "<你的大图.dwg>",
    "sectionXlsx": "tests/fixtures/section-30.xlsx",
    "cleanDxf": "tests/audit/fixtures/clean.dxf",
    "problemDxf": "tests/audit/fixtures/problem-rich.dxf",
    "sectionExpected": "tests/fixtures/section-30.expected.json",
    "hydroStation": "<站码>"
  },
  "categories": {
    "read": "读/查：看图纸回答问题（最常用的 agent 负载，决定 token 成本）",
    "edit": "改图：对既有实体做批量修改（平台写原语的试金石）",
    "section": "断面：从数据出图 + 回读核对（当前唯一的写路径，代表真实业务）",
    "check": "检核：audit 体检与回读断言（质量的守门人）",
    "stability": "异常/稳定性：错误是否可预期、可分类、不崩"
  },
  "tasks": [
    {
      "id": "Q1-layer-stats",
      "category": "read",
      "goal": "这张断面底图里 RIVER 图层上有多少实体？各是什么类型？再把 RIVER 图层所有线的总长度算给我（m）。",
      "why": "最典型的“看一眼图纸回答问题”；考察 read 一次返回多少字节、是否需要二次取数",
      "steps": [
        {
          "name": "open1",
          "kind": "cad",
          "cmd": "open",
          "args": [
            "-Doc",
            "{fixture:design-water.dxf}",
            "-ReadOnly"
          ],
          "timeoutSec": 180
        },
        {
          "name": "read1",
          "kind": "cad",
          "cmd": "read",
          "args": [
            "-Doc",
            "{fixture:design-water.dxf}",
            "-Mode",
            "geom",
            "-Max",
            "20000"
          ]
        }
      ],
      "maxCommands": 2,
      "undoCheck": false
    },
    {
      "id": "Q2-text-search",
      "category": "read",
      "goal": "把图里所有写着「设计水位」的文字找出来，给我句柄和文字内容。",
      "why": "按内容检索（query 原语的雏形）：agent 只能“全读再自己筛”，token 与耗时都被放大",
      "steps": [
        {
          "name": "open1",
          "kind": "cad",
          "cmd": "open",
          "args": [
            "-Doc",
            "{fixture:design-water.dxf}",
            "-ReadOnly"
          ],
          "timeoutSec": 180
        },
        {
          "name": "read1",
          "kind": "cad",
          "cmd": "read",
          "args": [
            "-Doc",
            "{fixture:design-water.dxf}",
            "-Mode",
            "geom",
            "-Max",
            "20000"
          ]
        }
      ],
      "maxCommands": 2,
      "undoCheck": false
    },
    {
      "id": "Q3-open-polylines",
      "category": "read",
      "goal": "图里有哪些多段线没有闭合？列出句柄，并说明哪一条看起来是“画完忘了闭合”的。",
      "why": "几何判读类问题；需要顶点坐标才能算首末点缺口 → 逼出 geom 级读取代价",
      "steps": [
        {
          "name": "open1",
          "kind": "cad",
          "cmd": "open",
          "args": [
            "-Doc",
            "{fixture:design-water.dxf}",
            "-ReadOnly"
          ],
          "timeoutSec": 180
        },
        {
          "name": "read1",
          "kind": "cad",
          "cmd": "read",
          "args": [
            "-Doc",
            "{fixture:design-water.dxf}",
            "-Mode",
            "geom",
            "-Max",
            "20000"
          ]
        }
      ],
      "maxCommands": 2,
      "undoCheck": false
    },
    {
      "id": "Q4-big-read",
      "category": "read",
      "goal": "打开这张真实水系分布图，告诉我一共多少实体、每个图层各多少，哪几个图层是空的。",
      "why": "大图读取 = 当前最贵的读操作（624 实体基线 209~224 s），E1 分级读的主要收益点；为控制基线时长单次运行",
      "steps": [
        {
          "name": "open1",
          "kind": "cad",
          "cmd": "open",
          "args": [
            "-Doc",
            "{asset:bigMap}",
            "-ReadOnly"
          ],
          "timeoutSec": 300
        },
        {
          "name": "read1",
          "kind": "cad",
          "cmd": "read",
          "args": [
            "-Doc",
            "{asset:bigMap}",
            "-Max",
            "20000"
          ],
          "timeoutSec": 900
        }
      ],
      "maxCommands": 2,
      "repeat": 1,
      "repeatNote": "单次读 ≥200 s；基线只跑 1 次控制时长，E1 后可放开到 3 次",
      "undoCheck": false
    },
    {
      "id": "W1-edit-text",
      "category": "edit",
      "goal": "把图上 3 处「设计水位」的文字改成「设计水位（复核）」，数值不变。",
      "why": "E2 后首次可做：query 定位 + entity 批量 update（set.text，带 expect 锚点）；checker 断言 read 回读的文字真的变了",
      "steps": [
        {
          "name": "open1",
          "kind": "cad",
          "cmd": "open",
          "args": [
            "-Doc",
            "{workdoc}"
          ]
        },
        {
          "name": "query1",
          "kind": "cad",
          "cmd": "query",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Type",
            "text",
            "-Text",
            "设计水位",
            "-Mode",
            "summary"
          ]
        },
        {
          "name": "gen1",
          "kind": "py",
          "script": "tests/bench/checkers/gen_entity_request.py",
          "args": [
            "--mode",
            "update-text",
            "--query",
            "{stepfile:query1}",
            "--set-text",
            "设计水位（复核）",
            "--out",
            "{rundir}/w1-entity.json"
          ]
        },
        {
          "name": "entity1",
          "kind": "cad",
          "cmd": "entity",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Items",
            "{rundir}/w1-entity.json"
          ],
          "timeoutSec": 180
        },
        {
          "name": "read1",
          "kind": "cad",
          "cmd": "read",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Mode",
            "geom",
            "-Max",
            "20000"
          ]
        }
      ],
      "maxCommands": 5,
      "undoCheck": true,
      "setup": {
        "copyFixture": "design-water.dxf"
      }
    },
    {
      "id": "W2-change-layer",
      "category": "edit",
      "goal": "把 RIVER 图层上的所有实体一次性移到 RIVER-2 图层。",
      "why": "query -Layer 定位 + entity update（set.layer）；checker 断言旧层为空、新层数量相符",
      "steps": [
        {
          "name": "open1",
          "kind": "cad",
          "cmd": "open",
          "args": [
            "-Doc",
            "{workdoc}"
          ]
        },
        {
          "name": "query1",
          "kind": "cad",
          "cmd": "query",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Layer",
            "RIVER",
            "-Mode",
            "summary"
          ]
        },
        {
          "name": "gen1",
          "kind": "py",
          "script": "tests/bench/checkers/gen_entity_request.py",
          "args": [
            "--mode",
            "update-layer",
            "--query",
            "{stepfile:query1}",
            "--set-layer",
            "RIVER-2",
            "--out",
            "{rundir}/w2-entity.json"
          ]
        },
        {
          "name": "entity1",
          "kind": "cad",
          "cmd": "entity",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Items",
            "{rundir}/w2-entity.json"
          ],
          "timeoutSec": 180
        },
        {
          "name": "read1",
          "kind": "cad",
          "cmd": "read",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Mode",
            "geom",
            "-Max",
            "20000"
          ]
        }
      ],
      "maxCommands": 5,
      "undoCheck": true,
      "setup": {
        "copyFixture": "design-water.dxf"
      }
    },
    {
      "id": "W3-unify-text-height",
      "category": "edit",
      "goal": "把注释层所有文字统一成字高 2.5，其它不变。",
      "why": "query -Layer/-Type 定位 + entity update（set.height）；checker 断言同层字高全部为 2.5",
      "steps": [
        {
          "name": "open1",
          "kind": "cad",
          "cmd": "open",
          "args": [
            "-Doc",
            "{workdoc}"
          ]
        },
        {
          "name": "query1",
          "kind": "cad",
          "cmd": "query",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Layer",
            "ANNO",
            "-Type",
            "text",
            "-Mode",
            "summary"
          ]
        },
        {
          "name": "gen1",
          "kind": "py",
          "script": "tests/bench/checkers/gen_entity_request.py",
          "args": [
            "--mode",
            "update-height",
            "--query",
            "{stepfile:query1}",
            "--set-height",
            "2.5",
            "--out",
            "{rundir}/w3-entity.json"
          ]
        },
        {
          "name": "entity1",
          "kind": "cad",
          "cmd": "entity",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Items",
            "{rundir}/w3-entity.json"
          ],
          "timeoutSec": 180
        },
        {
          "name": "read1",
          "kind": "cad",
          "cmd": "read",
          "args": [
            "-Doc",
            "{workdoc}",
            "-Mode",
            "geom",
            "-Max",
            "20000"
          ]
        }
      ],
      "maxCommands": 5,
      "undoCheck": true,
      "setup": {
        "copyFixture": "design-water.dxf"
      }
    },
    {
      "id": "W4-move-to-origin",
      "category": "edit",
      "goal": "这张画好的断面图整体向右平移 50 mm（左下角要落在 50,0），不要重画错位。",
      "why": "没有 move 原语时的真实 workaround = undo + 带 -Origin 重画；这条量化“缺原语”的代价（命令数 × 地板价）",
      "steps": [
        {
          "name": "open1",
          "kind": "cad",
          "cmd": "open",
          "args": [
            "-Doc",
            "{scratch}"
          ],
          "timeoutSec": 180
        },
        {
          "name": "prep1",
          "kind": "py",
          "script": "scripts/section/prepare.py",
          "args": [
            "--data",
            "{repo}/tests/fixtures/section-30.xlsx",
            "--water",
            "42.30=设计水位",
            "--out",
            "{rundir}/w4-origin0.model.json"
          ]
        },
        {
          "name": "sec1",
          "kind": "cad",
          "cmd": "section",
          "args": [
            "-Doc",
            "{scratch}",
            "-Data",
            "{rundir}/w4-origin0.model.json"
          ],
          "timeoutSec": 240
        },
        {
          "name": "read1",
          "kind": "cad",
          "cmd": "read",
          "args": [
            "-Doc",
            "{scratch}",
            "-Max",
            "20000"
          ]
        },
        {
          "name": "undo1",
          "kind": "cad",
          "cmd": "undo",
          "args": [
            "-Doc",
            "{scratch}",
            "-Token",
            "{ref:sec1.result.undoToken}"
          ]
        },
        {
          "name": "prep2",
          "kind": "py",
          "script": "scripts/section/prepare.py",
          "args": [
            "--data",
            "{repo}/tests/fixtures/section-30.xlsx",
            "--water",
            "42.30=设计水位",
            "--origin",
            "50,0",
            "--out",
            "{rundir}/w4-origin50.model.json"
          ]
        },
        {
          "name": "sec2",
          "kind": "cad",
          "cmd": "section",
          "args": [
            "-Doc",
            "{scratch}",
            "-Data",
            "{rundir}/w4-origin50.model.json"
          ],
          "timeoutSec": 240
        },
        {
          "name": "read2",
          "kind": "cad",
          "cmd": "read",
          "args": [
            "-Doc",
            "{scratch}",
            "-Max",
            "20000"
          ]
        }
      ],
      "maxCommands": 8,
      "undoCheck": true
    },
    {
      "id": "W5-delete-zero-lines",
      "category": "edit",
      "goal": "把图上所有零长度线删掉（打印出来看不见但会污染图纸的那种）。",
      "why": "query -Type line 拿 bbox 判零长 → entity 批量 delete；checker 断言回读里零长线为 0",
