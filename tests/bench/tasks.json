    {
      "id": "S3-water-edit-composite",
      "category": "section",
      "goal": "把断面图上的设计水位从 42.30 改成 43.00 重出一张；中间的旧图撤掉，最后顺手体检一下这张新图。",
      "why": "10 条命令的复合任务（出图→回读→体检→撤销→改参数→再出图→再体检）：最能体现 daemon 后的整体收益",
      "steps": [
        {
          "name": "open1",
          "kind": "cad",
          "cmd": "open",
          "args": [
            "-Doc",
            "{scratch}"
          ],
          "timeoutSec": 180
        },
        {
          "name": "prep1",
          "kind": "py",
          "script": "scripts/section/prepare.py",
          "args": [
            "--data",
            "{asset:sectionXlsx}",
            "--water",
            "42.30=设计水位",
            "--out",
            "{rundir}/s3-w4230.model.json"
          ]
        },
        {
          "name": "sec1",
          "kind": "cad",
          "cmd": "section",
          "args": [
            "-Doc",
            "{scratch}",
            "-Data",
            "{rundir}/s3-w4230.model.json"
          ],
          "timeoutSec": 240
        },
        {
          "name": "read1",
          "kind": "cad",
          "cmd": "read",
          "args": [
            "-Doc",
            "{scratch}",
            "-Mode",
            "geom",
            "-Max",
            "20000"
          ]
        },
        {
